<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootVBox" fillWidth="false" minHeight="768.0" minWidth="1024.0" prefHeight="768.0" prefWidth="1024.0" style="-fx-background-color: gray;" HBox.hgrow="ALWAYS" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.prepper.AddQuestionViewController">
    <FlowPane fx:id="topFlowPane" alignment="CENTER" columnHalignment="CENTER" hgap="25.0" maxWidth="Infinity" nodeOrientation="LEFT_TO_RIGHT" prefHeight="100.0" prefWidth="Infinity" rowValignment="TOP">
        <children>
            <Button fx:id="finishSet" prefHeight="38.0" prefWidth="134.0" text="Finish Set" />
            <Button fx:id="saveQuestion" prefHeight="38.0" prefWidth="138.0" text="Save Question" />
            <Button fx:id="createAnother" prefHeight="38.0" prefWidth="134.0" text="Create Another" />
        </children>
    </FlowPane>
   <HBox minWidth="1024.0">
      <children>
         <GridPane prefHeight="287.0" prefWidth="400.0">
           <columnConstraints>
             <ColumnConstraints hgrow="SOMETIMES" maxWidth="129.0" minWidth="10.0" prefWidth="72.0" />
             <ColumnConstraints hgrow="SOMETIMES" maxWidth="210.0" minWidth="10.0" prefWidth="195.0" />
               <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
           </columnConstraints>
           <rowConstraints>
               <RowConstraints minHeight="5.0" percentHeight="10.0" prefHeight="5.0" vgrow="SOMETIMES" />
             <RowConstraints minHeight="10.0" percentHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               <RowConstraints minHeight="10.0" percentHeight="10.0" prefHeight="30.0" valignment="CENTER" vgrow="SOMETIMES" />
             <RowConstraints minHeight="10.0" percentHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
             <RowConstraints minHeight="10.0" percentHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               <RowConstraints minHeight="10.0" percentHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               <RowConstraints minHeight="10.0" percentHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               <RowConstraints minHeight="10.0" percentHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
           </rowConstraints>
            <children>
               <Label text="Question" />
               <Label text="Image" GridPane.rowIndex="1" />
               <Label text="Answer A" GridPane.rowIndex="2" />
               <Label text="Answer B" GridPane.rowIndex="3" />
               <Label text="Answer C" GridPane.rowIndex="4" />
               <Label text="Answer D" GridPane.rowIndex="5" />
               <TextArea fx:id="QuestionInput" prefHeight="91.0" prefWidth="262.0" GridPane.columnIndex="1" />
               <Button fx:id="selectImageButton" mnemonicParsing="false" text="Select Image" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               <TextArea fx:id="AnswerAInput" prefHeight="200.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               <TextArea fx:id="AnswerBInput" prefHeight="200.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               <TextArea fx:id="AnswerCInput" prefHeight="200.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
               <TextArea fx:id="AnswerDInput" prefHeight="200.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
               <CheckBox fx:id="AnswerACheck" mnemonicParsing="false" text="A" GridPane.columnIndex="2" GridPane.rowIndex="2" />
               <CheckBox fx:id="AnswerBCheck" mnemonicParsing="false" text="B" GridPane.columnIndex="2" GridPane.rowIndex="3" />
               <CheckBox fx:id="AnswerCCheck" mnemonicParsing="false" text="D" GridPane.columnIndex="2" GridPane.rowIndex="5" />
               <CheckBox fx:id="AnswerDCheck" mnemonicParsing="false" text="C" GridPane.columnIndex="2" GridPane.rowIndex="4" />
