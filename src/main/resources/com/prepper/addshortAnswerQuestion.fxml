<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.prepper.addshortAnswerQuestion">
   <children>
      <TextField fx:id="questionBox" layoutX="138.0" layoutY="65.0" prefHeight="26.0" prefWidth="359.0" promptText="Question" AnchorPane.leftAnchor="110.0" AnchorPane.rightAnchor="110.0" />
      <TextArea fx:id="answerBox" layoutX="200.0" layoutY="123.0" prefHeight="200.0" prefWidth="200.0" promptText="Answer" AnchorPane.leftAnchor="110.0" AnchorPane.rightAnchor="110.0" />
      <Button fx:id="finishSetButton" layoutX="110.0" layoutY="14.0" mnemonicParsing="false" text="Finish Set" />
      <Button fx:id="saveQuestionButton" layoutX="384.0" layoutY="14.0" mnemonicParsing="false" text="Save Question" />
   </children>
</AnchorPane>
